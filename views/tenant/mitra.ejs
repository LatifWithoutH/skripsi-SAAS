<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kelola Mitra | SaaS Skripsi</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-50 font-sans">
  <div class="flex">
    <%- include('../partials/_sidebar', { isTenant: true }) %>
    
    <div class="flex-1 md:ml-64 min-h-screen flex flex-col">
      <%- include('../partials/_header', { user: user }) %>

      <main class="flex-1 p-6 md:p-8">
        <!-- Header & Notifikasi -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">Data Mitra Kerja Sama</h1>
            <p class="text-gray-500">Kelola daftar mitra industri dan institusi.</p>
          </div>
          
          <!-- 🔒 KEAMANAN FRONTEND: Hanya tampilkan jika BUKAN auditor -->
          <% if (user.role !== 'auditor') { %>
            <button onclick="toggleModal()" class="flex items-center gap-2 bg-indigo-600 text-white px-4 py-2.5 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm font-medium">
              <i data-lucide="plus" class="w-4 h-4"></i> Tambah Mitra
            </button>
          <% } %>
          
        </div>

        <% if (locals.success) { %>
          <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg flex items-center gap-2">
            <i data-lucide="check-circle" class="w-5 h-5"></i> Data mitra berhasil ditambahkan!
          </div>
        <% } %>

        <!-- Tabel Data -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <% if (mitras && mitras.length > 0) { %>
            <table class="w-full text-sm text-left">
              <thead class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-100 uppercase text-xs tracking-wider">
                <tr>
                  <th class="px-6 py-4">Nama Mitra</th>
                  <th class="px-6 py-4">Bidang / Industri</th>
                  <th class="px-6 py-4">Email Kontak</th>
                  <th class="px-6 py-4">Status</th>
                  
                  <!-- 🔒 KEAMANAN FRONTEND: Sembunyikan header Aksi dari auditor -->
                  <% if (user.role !== 'auditor') { %>
                    <th class="px-6 py-4 text-right">Aksi</th>
                  <% } %>
                  
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% mitras.forEach(function(mitra) { %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 font-medium text-gray-900"><%= mitra.name %></td>
                    <td class="px-6 py-4 text-gray-600"><%= mitra.industry || '-' %></td>
                    <td class="px-6 py-4 text-gray-600"><%= mitra.contact_email || '-' %></td>
                    <td class="px-6 py-4">
                      <% if (mitra.status === 'active') { %>
                        <span class="px-2.5 py-1 bg-emerald-100 text-emerald-700 rounded-full text-xs font-semibold">Aktif</span>
                      <% } else { %>
                        <span class="px-2.5 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-semibold">Nonaktif</span>
                      <% } %>
                    </td>
                    
                    <!-- 🔒 KEAMANAN FRONTEND: Sembunyikan tombol Edit/Hapus dari auditor -->
                    <% if (user.role !== 'auditor') { %>
                      <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <button class="p-2 text-gray-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors">
                            <i data-lucide="edit-3" class="w-4 h-4"></i>
                          </button>
                          <button class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                          </button>
                        </div>
                      </td>
                    <% } %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } else { %>
            <!-- Empty State -->
            <div class="p-12 text-center">
              <div class="bg-gray-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="inbox" class="w-8 h-8 text-gray-400"></i>
              </div>
              <h3 class="text-lg font-medium text-gray-900">Belum ada data mitra</h3>
              <p class="text-gray-500 mt-1 mb-4">Mulai tambahkan mitra kerja sama institusi Anda.</p>
              
              <!-- 🔒 KEAMANAN FRONTEND: Sembunyikan tombol di empty state dari auditor -->
              <% if (user.role !== 'auditor') { %>
                <button onclick="toggleModal()" class="text-indigo-600 font-semibold hover:underline">Tambah Mitra Pertama</button>
              <% } %>
              
            </div>
          <% } %>
        </div>
      </main>
    </div>
  </div>

  <!-- 🔒 KEAMANAN FRONTEND: Sembunyikan seluruh modal form dari auditor -->
  <% if (user.role !== 'auditor') { %>
    <div id="mitraModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4">
      <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
          <h3 class="text-lg font-bold text-gray-900">Tambah Mitra Baru</h3>
          <button onclick="toggleModal()" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>
        
        <form action="/mitra" method="POST" class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Institusi / Perusahaan</label>
            <input type="text" name="name" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm" placeholder="Contoh: PT. Teknologi Maju">
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Bidang / Industri</label>
              <input type="text" name="industry" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm" placeholder="Contoh: Teknologi">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Status</label>
              <select name="status" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white">
                <option value="active">Aktif</option>
                <option value="inactive">Nonaktif</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Email Kontak</label>
            <input type="email" name="contact_email" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm" placeholder="kontak@perusahaan.com">
          </div>

          <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
            <button type="button" onclick="toggleModal()" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Batal</button>
            <button type="submit" class="flex items-center gap-2 px-5 py-2 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 shadow-sm">
              <i data-lucide="save" class="w-4 h-4"></i> Simpan Data
            </button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <script>
    function toggleModal() {
      const modal = document.getElementById('mitraModal');
      if (modal) {
        modal.classList.toggle('hidden');
        modal.classList.toggle('flex');
      }
    }
    lucide.createIcons();
  </script>
</body>
</html>