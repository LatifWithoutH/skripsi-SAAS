<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard <%= typeof isFacultyOperator !== 'undefined' && isFacultyOperator ? 'Fakultas' : 'Tenant' %> | SIMITRADUDIKA</title>
  
  <!-- 1. CSS Lokal (Hasil Compile) -->
  <link href="/css/output.css" rel="stylesheet">
  
  <!-- 2. Lucide Lokal -->
  <script src="/js/lucide.min.js"></script>
  
  <!-- 3. Custom Style untuk Animasi & Scrollbar -->
  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
  </style>
</head>

<body class="bg-slate-50 font-sans text-slate-800 antialiased selection:bg-primary-100 selection:text-primary-700">
  
  <div class="flex min-h-screen">
    
    <!-- 1. SIDEBAR PARTIAL (Fixed di kiri) -->
    <%- include('../partials/_sidebar', { 
      isTenant: true, 
      isFacultyOperator: typeof isFacultyOperator !== 'undefined' ? isFacultyOperator : false 
    }) %>
    
    <!-- 2. MAIN CONTENT AREA (Geser ke kanan di desktop agar tidak tertutup sidebar) -->
    <div class="flex-1 md:ml-64 min-h-screen flex flex-col">
      
      <!-- HEADER PARTIAL -->
      <%- include('../partials/_header', { 
        user: typeof user !== 'undefined' ? user : { name: 'Admin', role: 'super_admin' },
        tenantName: typeof tenantName !== 'undefined' ? tenantName : 'SIMITRADUDIKA',
        pageTitle: 'Dashboard'
      }) %>

      <!-- CONTENT WRAPPER -->
      <main class="flex-1 p-4 md:p-8 space-y-6">
        
        <!-- NOTIFIKASI SUKSES -->
        <% if (typeof locals !== 'undefined' && (locals.success === 'true' || locals.success === 'resent')) { %>
          <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl flex items-start gap-3 animate-fade-in">
            <i data-lucide="check-circle-2" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
            <div>
              <p class="font-semibold text-sm">
                <%= locals.success === 'resent' ? 'Undangan berhasil dikirim ULANG ke' : 'Undangan berhasil dikirim ke' %> 
                <strong><%= locals.email %></strong>!
              </p>
              <p class="text-xs text-emerald-600 mt-1">Silakan cek inbox email (termasuk folder Spam) untuk mendapatkan password sementara.</p>
            </div>
          </div>
        <% } %>

        <!-- NOTIFIKASI: USER SUDAH AKTIF -->
        <% if (typeof locals !== 'undefined' && locals.error === 'user_active') { %>
          <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-xl flex items-start gap-3 animate-fade-in">
            <i data-lucide="info" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
            <div>
              <p class="font-semibold text-sm">Akun sudah aktif</p>
              <p class="text-xs text-blue-600 mt-1">Akun untuk <strong><%= locals.email %></strong> sudah aktif. Silakan minta pengguna tersebut untuk login atau lakukan reset password.</p>
            </div>
          </div>
        <% } %>

        <!-- NOTIFIKASI ERROR LAINNYA -->
        <% if (typeof locals !== 'undefined' && locals.error && locals.error !== 'user_active') { %>
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-start gap-3 animate-fade-in">
            <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
            <div>
              <p class="font-semibold text-sm">Terjadi Kesalahan</p>
              <p class="text-xs text-red-600 mt-1">
                <% if (locals.error === 'email_failed') { %> User berhasil dibuat, tetapi email gagal terkirim. Cek konfigurasi SMTP.
                <% } else if (locals.error === 'invalid_role') { %> Role yang dipilih tidak valid.
                <% } else if (locals.error === 'invalid_unit') { %> Unit yang dipilih tidak valid.
                <% } else { %> <%= locals.error %>
                <% } %>
              </p>
            </div>
          </div>
        <% } %>

        <!-- PAGE HEADER: Title & Action Button -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="text-2xl md:text-3xl font-bold text-slate-900 tracking-tight">
              Ringkasan <%= typeof isFacultyOperator !== 'undefined' && isFacultyOperator ? 'Fakultas' : 'Institusi' %>
            </h1>
            <p class="text-slate-500 text-sm mt-1">
              Pantau kesehatan dan perkembangan data <%= typeof isFacultyOperator !== 'undefined' && isFacultyOperator ? 'fakultas' : 'institusi' %> Anda secara real-time.
            </p>
          </div>
          
          <% if (typeof can === 'function' && can(user.role, 'write:users')) { %>
            <button onclick="toggleModal()" class="inline-flex items-center justify-center gap-2 bg-primary-600 text-white px-5 py-2.5 rounded-xl hover:bg-primary-700 transition-all shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 hover:-translate-y-0.5 active:translate-y-0 font-semibold text-sm">
              <i data-lucide="user-plus" class="w-4 h-4"></i> 
              <span class="hidden sm:inline">Undang Tim IT / Admin</span>
              <span class="sm:hidden">Undang Tim</span>
            </button>
          <% } %>
        </div>

        <!-- Banner Onboarding (Dinamis) -->
        <div class="bg-gradient-to-r from-primary-600 to-purple-600 rounded-2xl p-6 text-white shadow-xl shadow-primary-500/20 relative overflow-hidden">
          <!-- Decorative circle -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
          
          <div class="relative z-10 flex flex-col sm:flex-row items-start gap-4">
            <div class="bg-white/20 p-3 rounded-xl backdrop-blur-sm shrink-0">
              <i data-lucide="sparkles" class="w-6 h-6 text-white"></i>
            </div>
            <div class="flex-1">
              <h3 class="font-bold text-lg mb-1">Selamat Datang, <%= typeof user !== 'undefined' ? user.name : 'Admin' %>!</h3>
              <p class="text-primary-100 text-sm mb-4 max-w-2xl leading-relaxed">
                <%= typeof isFacultyOperator !== 'undefined' && isFacultyOperator 
                  ? 'Anda memiliki akses untuk mengelola data mitra dan kerjasama khusus untuk fakultas Anda.' 
                  : 'Sebagai inisiator, Anda dapat mengelola langganan atau mendelegasikan tugas teknis kepada tim IT kampus Anda.' %>
              </p>
              <div class="flex flex-wrap gap-3">
                <button class="bg-white text-primary-700 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-slate-50 transition-colors shadow-sm">Lihat Panduan</button>
                <button class="bg-primary-700/50 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-primary-700 transition-colors border border-primary-400/30 backdrop-blur-sm">
                  Atur Profil <%= typeof isFacultyOperator !== 'undefined' && isFacultyOperator ? 'Fakultas' : 'Institusi' %>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Cards (DINAMIS BERDASARKAN ROLE) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Card 1: Total Mitra -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/60 hover:shadow-md hover:border-primary-200 transition-all duration-300 group">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-semibold text-slate-500">
                <%= typeof isFacultyOperator !== 'undefined' && isFacultyOperator ? 'Mitra di Fakultas Anda' : 'Total Mitra Kerja Sama' %>
              </h3>
              <div class="p-2.5 bg-primary-50 text-primary-600 rounded-xl group-hover:scale-110 transition-transform">
                <i data-lucide="briefcase" class="w-5 h-5"></i>
              </div>
            </div>
            <p class="text-3xl font-bold text-slate-900"><%= typeof stats !== 'undefined' ? stats.totalMitra : '0' %></p>
            <p class="text-xs text-emerald-600 mt-2 flex items-center gap-1 font-medium">
              <i data-lucide="trending-up" class="w-3.5 h-3.5"></i> 
              <%= typeof isFacultyOperator !== 'undefined' && isFacultyOperator ? 'Fakultas ' + (user.name || '') : '+3 institusi bulan ini' %>
            </p>
          </div>
          
          <!-- Card 2: Conditional (Kerjasama Aktif untuk Faculty / Unit Aktif untuk Owner) -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/60 hover:shadow-md hover:border-blue-200 transition-all duration-300 group">
            <div class="flex items-center justify-between mb-4">
              <% if (typeof isFacultyOperator !== 'undefined' && isFacultyOperator) { %>
                <h3 class="text-sm font-semibold text-slate-500">Kerjasama Aktif</h3>
                <div class="p-2.5 bg-blue-50 text-blue-600 rounded-xl group-hover:scale-110 transition-transform">
                  <i data-lucide="file-signature" class="w-5 h-5"></i>
                </div>
              <% } else { %>
                <h3 class="text-sm font-semibold text-slate-500">Unit / Fakultas Aktif</h3>
                <div class="p-2.5 bg-blue-50 text-blue-600 rounded-xl group-hover:scale-110 transition-transform">
                  <i data-lucide="building-2" class="w-5 h-5"></i>
                </div>
              <% } %>
            </div>
            
            <% if (typeof isFacultyOperator !== 'undefined' && isFacultyOperator) { %>
              <p class="text-3xl font-bold text-slate-900"><%= typeof stats !== 'undefined' ? stats.totalKerjasama : '0' %></p>
              <p class="text-xs text-slate-400 mt-2">MoU/MoA berjalan di fakultas Anda</p>
            <% } else { %>
              <p class="text-3xl font-bold text-slate-900"><%= typeof stats !== 'undefined' ? stats.totalUnits : '0' %></p>
              <p class="text-xs text-slate-400 mt-2">Unit internal yang terdaftar di institusi Anda</p>
            <% } %>
          </div>

          <!-- Card 3: Status Sistem -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/60 hover:shadow-md hover:border-emerald-200 transition-all duration-300 group">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-semibold text-slate-500">Status Sistem & Langganan</h3>
              <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-xl group-hover:scale-110 transition-transform">
                <i data-lucide="shield-check" class="w-5 h-5"></i>
              </div>
            </div>
            <p class="text-3xl font-bold text-slate-900"><%= typeof stats !== 'undefined' ? stats.systemStatus : 'Aktif' %></p>
            <p class="text-xs text-slate-400 mt-2">Terakhir dicek: <%= typeof stats !== 'undefined' ? stats.lastAudit : 'Baru saja' %></p>
          </div>
        </div>

        <!-- Recent Activity Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <h3 class="font-bold text-slate-800 flex items-center gap-2">
              <i data-lucide="activity" class="w-4 h-4 text-primary-600"></i>
              Aktivitas Penting Terbaru
            </h3>
            <a href="/log-aktivitas" class="text-sm text-primary-600 hover:text-primary-700 font-semibold hover:underline transition-colors flex items-center gap-1">
              Lihat Log Lengkap <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
          
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200">
                <tr>
                  <th class="px-6 py-3.5">Unit / Pengguna</th>
                  <th class="px-6 py-3.5">Aktivitas</th>
                  <th class="px-6 py-3.5">Waktu</th>
                  <th class="px-6 py-3.5">Dampak</th>
                </tr>
              </thead>

              <tbody class="divide-y divide-slate-100">
                <% if (typeof recentLogs !== 'undefined' && recentLogs && recentLogs.length > 0) { %>
                  <% recentLogs.forEach(function(log) { 
                    let badgeClass = 'bg-slate-100 text-slate-700';
                    let badgeText = 'Informasi';
                    const action = (log.action || '').toUpperCase();
                    
                    if (action.includes('CREATE') || action.includes('ADD') || action.includes('INVITE')) {
                      badgeClass = 'bg-emerald-50 text-emerald-700 border border-emerald-100';
                      badgeText = 'Data Bertambah';
                    } else if (action.includes('LOGIN') || action.includes('AUTH')) {
                      badgeClass = 'bg-blue-50 text-blue-700 border border-blue-100';
                      badgeText = 'Akses Masuk';
                    } else if (action.includes('FAIL') || action.includes('ERROR') || action.includes('DELETE')) {
                      badgeClass = 'bg-red-50 text-red-700 border border-red-100';
                      badgeText = 'Peringatan';
                    } else if (action.includes('UPDATE')) {
                      badgeClass = 'bg-amber-50 text-amber-700 border border-amber-100';
                      badgeText = 'Pembaruan';
                    }
                  %>
                    <tr class="hover:bg-slate-50/80 transition-colors">
                      <td class="px-6 py-4 font-medium text-slate-900">
                        <%= log.unit_name || (typeof user !== 'undefined' ? user.name : 'Sistem') %>
                      </td>
                      <td class="px-6 py-4 text-slate-600">
                        <%= log.details || log.action %>
                      </td>
                      <td class="px-6 py-4 text-slate-500 text-xs whitespace-nowrap">
                        <%= new Date(log.created_at).toLocaleString('id-ID', { 
                          day: 'numeric', month: 'short', year: 'numeric', 
                          hour: '2-digit', minute: '2-digit' 
                        }) %>
                      </td>
                      <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-1 <%= badgeClass %> rounded-full text-xs font-semibold">
                          <%= badgeText %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="px-6 py-12 text-center">
                      <div class="flex flex-col items-center justify-center text-slate-400">
                        <div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center mb-3">
                          <i data-lucide="inbox" class="w-6 h-6 text-slate-400"></i>
                        </div>
                        <p class="text-sm font-semibold text-slate-600">Belum ada aktivitas tercatat</p>
                        <p class="text-xs text-slate-400 mt-1 max-w-xs">Aktivitas akan muncul di sini setelah ada tindakan di sistem.</p>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>              
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
    
  <!-- MODAL: Undang Anggota Tim (Hanya di-render jika punya izin) -->
  <% if (typeof can === 'function' && typeof user !== 'undefined' && can(user.role, 'write:users')) { %>
  <div id="inviteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 transition-opacity duration-300">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all scale-100">
      <!-- Header Modal -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-primary-50 text-primary-600 rounded-lg">
            <i data-lucide="mail-plus" class="w-5 h-5"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Undang Anggota Tim</h3>
        </div>
        <button onclick="toggleModal()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors" aria-label="Tutup modal">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
  
      <!-- Body Modal (Form) -->
      <form action="/team/invite" method="POST" class="p-6 space-y-5">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Email Tim IT / Admin <span class="text-red-500">*</span></label>
          <div class="relative">
            <i data-lucide="mail" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
            <input type="email" name="email" required class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 outline-none transition-all text-sm placeholder:text-slate-400" placeholder="tim.it@kampus.ac.id">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- DROPDOWN ROLE -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Hak Akses (Role) <span class="text-red-500">*</span></label>
            <div class="relative">
              <select name="role_id" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 outline-none transition-all text-sm appearance-none cursor-pointer">
                <% if (typeof locals !== 'undefined' && locals.roles && locals.roles.length > 0) { %>
                  <% locals.roles.forEach(function(role) { %>
                    <option value="<%= role.id %>">
                      <%= role.name.replace(/_/g, ' ').toUpperCase() %>
                    </option>
                  <% }); %>
                <% } else { %>
                  <option value="">Tidak ada role tersedia</option>
                <% } %>
              </select>
              <i data-lucide="chevron-down" class="absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
            </div>
          </div>

          <!-- DROPDOWN UNIT -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Unit / Fakultas</label>
            <div class="relative">
              <select name="unit_id" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 outline-none transition-all text-sm appearance-none cursor-pointer">
                <option value="">Tidak terikat (Akses Seluruh Unit)</option>
                <% if (typeof locals !== 'undefined' && locals.units && locals.units.length > 0) { %>
                  <% locals.units.forEach(function(unit) { %>
                    <option value="<%= unit.id %>">
                      <%= unit.name %> (<%= unit.code %>)
                    </option>
                  <% }); %>
                <% } %>
              </select>
              <i data-lucide="chevron-down" class="absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
            </div>
          </div>
        </div>

        <!-- Info Keamanan -->
        <div class="bg-primary-50 border border-primary-100 rounded-xl p-3.5 flex gap-3 items-start">
          <i data-lucide="shield-check" class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5"></i>
          <div>
            <p class="text-sm font-semibold text-primary-900">Keamanan Multi-Tenant Terjamin</p>
            <p class="text-xs text-primary-700 mt-0.5 leading-relaxed">User yang diundang terikat pada <code class="bg-primary-100 px-1 py-0.5 rounded text-primary-800 font-mono text-[10px]">tenant_id</code> institusi Anda. Mereka tidak akan bisa melihat atau mengakses data institusi lain.</p>
          </div>
        </div>

        <!-- Footer Modal -->
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
          <button type="button" onclick="toggleModal()" class="px-4 py-2.5 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-50 transition-colors">Batal</button>
          <button type="submit" class="flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-primary-600 rounded-xl hover:bg-primary-700 shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all">
            <i data-lucide="send" class="w-4 h-4"></i> Kirim Undangan
          </button>
        </div>
      </form>
    </div>
  </div>
  <% } %>
  
  <!-- SCRIPTS -->
  <script>
    // Modal Toggle Logic
    function toggleModal() {
      const modal = document.getElementById('inviteModal');
      if (modal) {
        if (modal.classList.contains('hidden')) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          // Optional: Add a small delay for fade-in effect if you add opacity classes
        }
        else {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      }
    }
  
    // Close modal when clicking outside
    document.getElementById('inviteModal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        toggleModal();
      }
    });

    // Initialize Lucide Icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>

  <!-- Global Script (jika ada) -->
  <script src="/js/script.js"></script>
</body>
</html>