<header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
  <div class="flex items-center justify-between px-6 py-3">
    
    <!-- Left Side: Brand & Context -->
    <div class="flex items-center gap-4">
      <!-- Mobile Menu Toggle -->
      <button class="md:hidden p-2 text-slate-500 hover:bg-slate-100 rounded-lg transition-colors">
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>
      
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex bg-indigo-600 text-white p-2 rounded-lg shadow-sm shadow-indigo-200">
          <i data-lucide="layers" class="w-5 h-5"></i>
        </div>
        <div>
          <% 
            // Fallback awal (akan ditimpa oleh JavaScript di bawah jika ada di map)
            const safePageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'Dashboard';
            const safeTenantName = (typeof tenantName !== 'undefined' && tenantName) ? tenantName : 'SaaS Multi-Tenant';
            const safeRole = (typeof user !== 'undefined' && user.role) ? user.role.replace(/_/g, ' ').toUpperCase() : 'ADMIN';
          %>
          
          <!-- ✅ TAMBAHAN: id="dynamic-page-title" agar bisa diubah oleh JavaScript -->
          <h1 id="dynamic-page-title" class="text-lg font-bold text-slate-800 tracking-tight">
            <%= safePageTitle %>
          </h1>
          <p class="text-xs text-slate-500 hidden sm:block">
            <%= safeTenantName %>
          </p>
        </div>
        
        <!-- Role Badge -->
        <span class="hidden sm:block text-slate-300">|</span>
        <span class="hidden sm:block text-[10px] font-bold text-indigo-600 bg-indigo-50 border border-indigo-100 px-2 py-0.5 rounded-full uppercase tracking-wider">
          <%= safeRole %>
        </span>
      </div>
    </div>

    <!-- Right Side: User Profile & Actions -->
    <div class="flex items-center gap-4">
      <!-- Notification Bell -->
      <button class="relative p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
      </button>

      <!-- Divider -->
      <div class="h-8 w-px bg-slate-200 mx-1 hidden sm:block"></div>

      <!-- User Info -->
      <div class="flex items-center gap-3">
        <% 
          const safeUserName = (typeof user !== 'undefined' && user.name) ? user.name : 'Administrator';
          const safeUnitName = (typeof user !== 'undefined' && user.unitName) ? user.unitName : '';
          const initialChar = safeUserName.trim().charAt(0).toUpperCase();
        %>

        <div class="text-right hidden sm:block">
          <p class="text-sm font-semibold text-slate-800 truncate max-w-[150px]">
            <%= safeUserName %>
          </p>
          <p class="text-[10px] text-slate-500 font-medium uppercase tracking-wider">
            <%= safeUnitName %>
          </p>
        </div>
        
        <!-- Avatar -->
        <div class="h-9 w-9 bg-gradient-to-br from-indigo-500 to-purple-600 text-white rounded-full flex items-center justify-center font-bold text-sm shadow-md border border-indigo-100 shrink-0">
          <%= initialChar %>
        </div>

        <!-- Logout Button -->
        <form action="/logout" method="POST">
          <button type="submit" title="Keluar dari Sistem" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
            <i data-lucide="log-out" class="w-5 h-5"></i>
          </button>
        </form>
      </div>
    </div>
  </div>
</header>

<script>
  // ✅ FITUR BARU: Auto-detect judul halaman berdasarkan URL
  document.addEventListener('DOMContentLoaded', function() {
    const path = window.location.pathname;
    
    // Peta URL ke Judul yang diinginkan
    const titleMap = {
      '/dashboard': 'Dashboard',
      '/kerjasama': 'Dokumen Kerjasama',
      '/mitra': 'Data Mitra',
      '/users': 'Kelola Tim',
      '/laporan': 'Laporan',
      '/log-aktivitas': 'Log Aktivitas',
      '/dokumen': 'Arsip Dokumen'
    };
    
    // Ambil judul yang cocok, atau gunakan 'Dashboard' jika URL tidak terdaftar
    const detectedTitle = titleMap[path] || 'Dashboard';
    
    // Update teks di elemen <h1>
    const titleElement = document.getElementById('dynamic-page-title');
    if (titleElement) {
      titleElement.textContent = detectedTitle;
    }
  });

  // Inisialisasi ikon Lucide
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>