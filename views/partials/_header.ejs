<header class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30 shadow-sm transition-all duration-300">
  <div class="flex items-center justify-between px-4 md:px-6 py-3">
    
    <!-- Left Side: Brand & Context -->
    <div class="flex items-center gap-3 md:gap-4">
      <!-- Mobile Menu Toggle -->
      <button type="button" aria-label="Buka menu navigasi" class="md:hidden p-2 text-slate-500 hover:bg-slate-100 hover:text-primary-600 rounded-lg transition-all">
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>
      
      <div class="flex items-center gap-3">
        <!-- Logo Icon -->
        <div class="hidden sm:flex bg-primary-600 text-white p-2 rounded-lg shadow-md shadow-primary-500/30">
          <i data-lucide="layers" class="w-5 h-5"></i>
        </div>
        
        <div>
          <% 
            // Fallback aman untuk variabel EJS
            const safePageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'Dashboard';
            const safeTenantName = (typeof tenantName !== 'undefined' && tenantName) ? tenantName : 'SaaS Multi-Tenant';
            const safeRole = (typeof user !== 'undefined' && user && user.role) ? user.role.replace(/_/g, ' ').toUpperCase() : 'ADMIN';
          %>
          
          <!-- Dynamic Page Title -->
          <h1 id="dynamic-page-title" class="text-base md:text-lg font-bold text-slate-800 tracking-tight leading-tight">
            <%= safePageTitle %>
          </h1>
          <p class="text-xs text-slate-500 hidden sm:block mt-0.5">
            <%= safeTenantName %>
          </p>
        </div>
        
        <!-- Role Badge -->
        <span class="hidden sm:block text-slate-300">|</span>
        <span class="hidden sm:inline-flex items-center text-[10px] font-bold text-primary-600 bg-primary-50 border border-primary-100 px-2 py-0.5 rounded-full uppercase tracking-wider">
          <%= safeRole %>
        </span>
      </div>
    </div>

    <!-- Right Side: User Profile & Actions -->
    <div class="flex items-center gap-2 md:gap-4">
      <!-- Notification Bell -->
      <button type="button" aria-label="Notifikasi" class="relative p-2 text-slate-400 hover:text-primary-600 hover:bg-primary-50 rounded-lg transition-all">
        <i data-lucide="bell" class="w-5 h-5"></i>
        <span class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white animate-pulse"></span>
      </button>

      <!-- Divider -->
      <div class="h-8 w-px bg-slate-200 mx-1 hidden sm:block"></div>

      <!-- User Info -->
      <div class="flex items-center gap-3">
        <% 
          const safeUserName = (typeof user !== 'undefined' && user && user.name) ? user.name : 'Administrator';
          const safeUnitName = (typeof user !== 'undefined' && user && user.unitName) ? user.unitName : '';
          const initialChar = safeUserName.trim().charAt(0).toUpperCase();
        %>

        <div class="text-right hidden md:block">
          <p class="text-sm font-semibold text-slate-800 truncate max-w-[150px]">
            <%= safeUserName %>
          </p>
          <% if (safeUnitName) { %>
            <p class="text-[10px] text-slate-500 font-medium uppercase tracking-wider">
              <%= safeUnitName %>
            </p>
          <% } %>
        </div>
        
        <!-- Avatar -->
        <div class="h-9 w-9 bg-gradient-to-br from-primary-500 to-purple-600 text-white rounded-full flex items-center justify-center font-bold text-sm shadow-md border border-primary-100 shrink-0 ring-2 ring-white">
          <%= initialChar %>
        </div>

        <!-- Logout Button -->
        <form action="/logout" method="POST" class="hidden sm:block">
          <button type="submit" title="Keluar dari Sistem" aria-label="Keluar dari sistem" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all">
            <i data-lucide="log-out" class="w-5 h-5"></i>
          </button>
        </form>
      </div>
    </div>
  </div>
</header>

<script>
  // ✅ FITUR: Auto-detect judul halaman berdasarkan URL
  document.addEventListener('DOMContentLoaded', function() {
    const path = window.location.pathname;
    
    // Peta URL ke Judul yang diinginkan (bisa diperluas sesuai kebutuhan)
    const titleMap = {
      '/dashboard': 'Dashboard',
      '/kerjasama': 'Dokumen Kerjasama',
      '/mitra': 'Data Mitra',
      '/users': 'Kelola Tim',
      '/laporan': 'Laporan & Analitik',
      '/log-aktivitas': 'Log Aktivitas',
      '/dokumen': 'Arsip Dokumen',
      '/pengaturan': 'Pengaturan Institusi'
    };
    
    // Ambil judul yang cocok, atau gunakan 'Dashboard' sebagai fallback
    const detectedTitle = titleMap[path] || 'Dashboard';
    
    // Update teks di elemen <h1>
    const titleElement = document.getElementById('dynamic-page-title');
    if (titleElement) {
      titleElement.textContent = detectedTitle;
    }
  });

  // Inisialisasi ikon Lucide (dengan safety check)
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>