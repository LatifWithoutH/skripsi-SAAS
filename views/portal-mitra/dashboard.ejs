<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Mitra | SIMITRADUDIKA</title>
  
  <!-- 1. CSS Lokal (Hasil Compile) -->
  <link href="/css/output.css" rel="stylesheet">
  
  <!-- 2. Lucide Lokal -->
  <script src="/js/lucide.min.js"></script>
  
  <!-- 3. Custom Style untuk Animasi & Scrollbar -->
  <style>
    @keyframes fadeInUp {
      0% { opacity: 0; transform: translateY(15px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
    
    /* Custom scrollbar untuk tabel agar lebih rapi */
    .custom-scrollbar::-webkit-scrollbar { height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-primary-100 selection:text-primary-700">
  
  <!-- Header Profesional dengan Glassmorphism -->
  <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-200/60 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-4">
        <div class="bg-primary-600 text-white p-2.5 rounded-xl shadow-lg shadow-primary-500/20">
          <i data-lucide="building-2" class="w-6 h-6"></i>
        </div>
        <div>
          <h1 class="font-bold text-slate-900 text-lg tracking-tight">Portal Mitra Industri</h1>
          <p class="text-xs text-slate-500 font-medium hidden sm:block">Kelola dokumen kerjasama Anda dengan aman</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="text-right hidden sm:block">
          <p class="text-sm font-bold text-slate-800"><%= typeof mitraName !== 'undefined' ? mitraName : 'Mitra' %></p>
          <p class="text-[10px] uppercase tracking-wider text-primary-600 font-semibold">Penanggung Jawab</p>
        </div>
        <form action="/portal-mitra/logout" method="POST">
          <button type="submit" class="group flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-red-50 hover:text-red-600 rounded-xl transition-all duration-200 border border-transparent hover:border-red-100">
            <i data-lucide="log-out" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"></i> 
            <span class="hidden sm:inline">Keluar</span>
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 md:px-6 py-8 space-y-8">
    
    <!-- Welcome Banner dengan Pattern Halus -->
    <div class="relative overflow-hidden bg-gradient-to-br from-primary-600 via-primary-700 to-purple-800 rounded-2xl p-6 md:p-8 text-white shadow-xl shadow-primary-500/10 animate-fade-in-up">
      <!-- Decorative Background Circles -->
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-white/5 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-48 h-48 rounded-full bg-blue-400/10 blur-2xl"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold mb-3 flex items-center gap-3">
            Halo, <%= typeof mitraName !== 'undefined' ? mitraName : 'Mitra' %>! <span class="animate-pulse">👋</span>
          </h2>
          <p class="text-primary-100 text-sm leading-relaxed">
            Ini adalah dashboard resmi Anda di <strong>SIMITRADUDIKA</strong>. Pantau status dokumen kerjasama (MoU/MoA/IA) antara perusahaan Anda dengan institusi kami. Pastikan semua dokumen tetap <span class="bg-white/20 px-1.5 py-0.5 rounded font-semibold text-white">Aktif</span> untuk kelancaran program.
          </p>
        </div>
        <div class="flex-shrink-0 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-4 flex items-center gap-3">
          <div class="bg-emerald-500/20 p-2 rounded-lg">
            <i data-lucide="shield-check" class="w-6 h-6 text-emerald-300"></i>
          </div>
          <div>
            <p class="text-xs text-primary-200 font-medium">Status Sistem</p>
            <p class="text-sm font-bold text-white">Terverifikasi & Aman</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Cards dengan Hover Effect -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 animate-fade-in-up" style="animation-delay: 0.1s;">
      <!-- Card 1: Active -->
      <div class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200/60 hover:shadow-lg hover:border-primary-200 hover:-translate-y-1 transition-all duration-300 flex items-center gap-5">
        <div class="p-4 bg-emerald-50 text-emerald-600 rounded-2xl group-hover:bg-emerald-100 group-hover:scale-110 transition-all duration-300">
          <i data-lucide="file-check" class="w-7 h-7"></i>
        </div>
        <div>
          <p class="text-sm text-slate-500 font-medium mb-1">Dokumen Aktif</p>
          <p class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= typeof stats !== 'undefined' && stats ? stats.activeCount : 0 %></p>
        </div>
      </div>
      
      <!-- Card 2: Total -->
      <div class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200/60 hover:shadow-lg hover:border-blue-200 hover:-translate-y-1 transition-all duration-300 flex items-center gap-5">
        <div class="p-4 bg-blue-50 text-blue-600 rounded-2xl group-hover:bg-blue-100 group-hover:scale-110 transition-all duration-300">
          <i data-lucide="folder-open" class="w-7 h-7"></i>
        </div>
        <div>
          <p class="text-sm text-slate-500 font-medium mb-1">Total Riwayat</p>
          <p class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= typeof kerjasamaList !== 'undefined' && kerjasamaList ? kerjasamaList.length : 0 %></p>
        </div>
      </div>

      <!-- Card 3: Bantuan -->
      <div class="group bg-white p-6 rounded-2xl shadow-sm border border-slate-200/60 hover:shadow-lg hover:border-amber-200 hover:-translate-y-1 transition-all duration-300 flex items-center gap-5">
        <div class="p-4 bg-amber-50 text-amber-600 rounded-2xl group-hover:bg-amber-100 group-hover:scale-110 transition-all duration-300">
          <i data-lucide="headphones" class="w-7 h-7"></i>
        </div>
        <div>
          <p class="text-sm text-slate-500 font-medium mb-1">Butuh Bantuan?</p>
          <a href="mailto:admin@kampus.ac.id" class="text-sm font-bold text-primary-600 hover:text-primary-700 hover:underline decoration-2 underline-offset-2 transition-all">Hubungi Admin Kampus &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Tabel Kerjasama -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 overflow-hidden animate-fade-in-up" style="animation-delay: 0.2s;">
      <div class="px-6 py-5 border-b border-slate-100 flex flex-col sm:flex-row justify-between sm:items-center gap-4 bg-slate-50/50">
        <h3 class="font-bold text-slate-800 flex items-center gap-2.5">
          <div class="p-1.5 bg-primary-100 text-primary-600 rounded-lg">
            <i data-lucide="file-text" class="w-4 h-4"></i>
          </div>
          Daftar Dokumen Kerjasama
        </h3>
      </div>
      
      <% if (typeof kerjasamaList !== 'undefined' && kerjasamaList && kerjasamaList.length > 0) { %>
        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase text-[11px] tracking-wider">
              <tr>
                <th class="px-6 py-4">Judul Kerjasama</th>
                <th class="px-6 py-4">Jenis</th>
                <th class="px-6 py-4">Masa Berlaku</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% kerjasamaList.forEach(function(k) { %>
                <tr class="group hover:bg-primary-50/30 transition-colors duration-200">
                  <td class="px-6 py-4 font-semibold text-slate-900"><%= k.judul %></td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold border border-slate-200 group-hover:bg-white group-hover:border-primary-200 group-hover:text-primary-700 transition-all">
                      <%= k.jenis %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-slate-600 text-xs">
                    <div class="flex flex-col gap-1.5">
                      <span class="flex items-center gap-1.5 text-slate-700"><i data-lucide="calendar" class="w-3.5 h-3.5 text-slate-400"></i> Mulai: <%= new Date(k.tanggal_mulai).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></span>
                      <span class="flex items-center gap-1.5 text-slate-500"><i data-lucide="calendar-x" class="w-3.5 h-3.5 text-slate-400"></i> Akhir: <%= new Date(k.tanggal_berakhir).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></span>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <% if (k.current_status === 'active') { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </span>
                        Aktif
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Expired
                      </span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-200">
                      <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-600 bg-white hover:bg-slate-50 rounded-lg transition-colors border border-slate-200 shadow-sm">
                        <i data-lucide="eye" class="w-3.5 h-3.5"></i> Lihat
                      </button>
                      <button onclick="openUploadModal('<%= k.id %>')" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-all shadow-sm shadow-primary-500/25 hover:shadow-primary-500/40 hover:-translate-y-0.5">
                        <i data-lucide="upload-cloud" class="w-3.5 h-3.5"></i> Unggah
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <!-- Empty State yang Lebih Informatif & Estetik -->
        <div class="p-12 md:p-16 text-center animate-fade-in-up">
          <div class="bg-slate-100 w-20 h-20 md:w-24 md:h-24 rounded-full flex items-center justify-center mx-auto mb-6 border-2 border-dashed border-slate-200">
            <i data-lucide="inbox" class="w-8 h-8 md:w-10 md:h-10 text-slate-400"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Belum Ada Dokumen</h3>
          <p class="text-slate-500 max-w-md mx-auto mb-8 leading-relaxed text-sm md:text-base">
            Saat ini belum ada dokumen kerjasama (MoU/MoA/IA) yang tercatat untuk perusahaan Anda. Silakan hubungi admin kampus untuk memulai proses kerjasama.
          </p>
          <a href="mailto:admin@kampus.ac.id" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-bold text-white bg-primary-600 rounded-xl hover:bg-primary-700 transition-all shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 hover:-translate-y-0.5">
            <i data-lucide="mail" class="w-4 h-4"></i> Hubungi Admin untuk Kerjasama
          </a>
        </div>
      <% } %>
    </div>

  </main>
  
  <!-- ========================================== -->
  <!-- MODAL UNGGAH DOKUMEN MITRA (DRAG & DROP STYLE) -->
  <!-- ========================================== -->
  <div id="uploadModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 transition-opacity duration-300">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden transform transition-all scale-100 border border-slate-200/60">
      
      <!-- Header Modal -->
      <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100 bg-slate-50/80">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-primary-100 text-primary-600 rounded-lg">
            <i data-lucide="upload-cloud" class="w-5 h-5"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Unggah Dokumen</h3>
        </div>
        <button onclick="closeUploadModal()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors" aria-label="Tutup modal">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Form Upload -->
      <form action="/portal-mitra/upload-dokumen" method="POST" enctype="multipart/form-data" class="p-6 space-y-5">
        <input type="hidden" name="kerjasama_id" id="upload_kerjasama_id">

        <!-- Modern Drag & Drop Zone -->
        <div>
          <label class="flex flex-col items-center justify-center w-full h-40 border-2 border-slate-300 border-dashed rounded-xl cursor-pointer bg-slate-50 hover:bg-primary-50 hover:border-primary-400 transition-all duration-200 group">
            <div class="flex flex-col items-center justify-center pt-5 pb-6">
              <i data-lucide="cloud-upload" class="w-10 h-10 mb-3 text-slate-400 group-hover:text-primary-500 transition-colors"></i>
              <p class="mb-1 text-sm text-slate-600"><span class="font-bold text-primary-600 group-hover:underline">Klik untuk unggah</span> atau drag & drop</p>
              <p class="text-xs text-slate-400">PDF, JPG, atau PNG (Maksimal 5MB)</p>
            </div>
            <input type="file" name="dokumen" id="fileInput" class="hidden" accept=".pdf,.jpg,.jpeg,.png" required onchange="updateFileName(this)" />
          </label>
          <!-- File Name Display (Muncul setelah file dipilih) -->
          <p id="file-name-display" class="hidden mt-3 p-3 bg-emerald-50 border border-emerald-200 rounded-lg flex items-center gap-2 text-sm text-emerald-700 font-medium">
            <i data-lucide="check-circle-2" class="w-4 h-4"></i>
            <span id="file-name-text" class="truncate"></span>
          </p>
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button type="button" onclick="closeUploadModal()" class="px-5 py-2.5 text-sm font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-colors">
            Batal
          </button>
          <button type="submit" class="px-5 py-2.5 text-sm font-bold text-white bg-primary-600 hover:bg-primary-700 rounded-xl transition-all shadow-md shadow-primary-500/25 hover:shadow-primary-500/40 flex items-center gap-2">
            <i data-lucide="upload" class="w-4 h-4"></i> Unggah Sekarang
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Inisialisasi icon Lucide
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
    
    // Fungsi Buka Modal
    function openUploadModal(kerjasamaId) {
      document.getElementById('upload_kerjasama_id').value = kerjasamaId;
      const modal = document.getElementById('uploadModal');
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        // Reset file input saat modal dibuka
        const fileInput = document.getElementById('fileInput');
        if (fileInput) fileInput.value = '';
        const fileNameDisplay = document.getElementById('file-name-display');
        if (fileNameDisplay) fileNameDisplay.classList.add('hidden');
      }
    }

    // Fungsi Tutup Modal
    function closeUploadModal() {
      const modal = document.getElementById('uploadModal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
      const form = document.querySelector('form[action="/portal-mitra/upload-dokumen"]');
      if (form) form.reset();
      const fileNameDisplay = document.getElementById('file-name-display');
      if (fileNameDisplay) fileNameDisplay.classList.add('hidden');
    }

    // Fungsi Menampilkan Nama File yang Dipilih (UX Enhancement)
    function updateFileName(input) {
      const display = document.getElementById('file-name-display');
      const text = document.getElementById('file-name-text');
      if (input.files && input.files[0]) {
        text.textContent = input.files[0].name;
        display.classList.remove('hidden');
        // Re-render icon check-circle setelah DOM berubah
        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
        }
      } else {
        display.classList.add('hidden');
      }
    }

    // Tutup modal jika user klik di area gelap (backdrop)
    document.getElementById('uploadModal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        closeUploadModal();
      }
    });
  </script>

  <!-- Global Script -->
  <script src="/js/script.js"></script>
</body>
</html>