<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Mitra | SI-MITRA-DUDIKA</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 font-sans">
  
  <!-- Header Profesional -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-10 shadow-sm">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-4">
        <div class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-sm">
          <i data-lucide="building-2" class="w-6 h-6"></i>
        </div>
        <div>
          <h1 class="font-bold text-slate-900 text-lg">Portal Mitra Industri</h1>
          <p class="text-xs text-slate-500">Kelola dokumen kerjasama Anda dengan aman</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="text-right hidden sm:block">
          <p class="text-sm font-semibold text-slate-800"><%= mitraName %></p>
          <p class="text-xs text-indigo-600 font-medium">Penanggung Jawab</p>
        </div>
        <form action="/portal-mitra/logout" method="POST">
          <button type="submit" class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-red-50 hover:text-red-600 rounded-lg transition-colors">
            <i data-lucide="log-out" class="w-4 h-4"></i> <span class="hidden sm:inline">Keluar</span>
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-8">
    
    <!-- Welcome Banner -->
    <div class="bg-gradient-to-r from-indigo-600 to-blue-700 rounded-2xl p-6 text-white mb-8 shadow-lg">
      <h2 class="text-xl font-bold mb-2">Halo, <%= mitraName %>! 👋</h2>
      <p class="text-indigo-100 text-sm max-w-2xl">
        Ini adalah dashboard resmi Anda di SI-MITRA-DUDIKA. Di sini Anda dapat memantau status dokumen kerjasama (MoU/MoA/IA) antara perusahaan Anda dengan institusi kami. 
        Pastikan semua dokumen tetap <strong>Aktif</strong> untuk kelancaran program.
      </p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <!-- Card 1: Active -->
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 flex items-center gap-4">
        <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
          <i data-lucide="file-check" class="w-6 h-6"></i>
        </div>
        <div>
          <p class="text-sm text-slate-500 font-medium">Dokumen Aktif</p>
          <p class="text-3xl font-bold text-slate-900"><%= stats.activeCount %></p>
        </div>
      </div>
      
      <!-- Card 2: Total -->
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 flex items-center gap-4">
        <div class="p-3 bg-blue-50 text-blue-600 rounded-xl">
          <i data-lucide="folder-open" class="w-6 h-6"></i>
        </div>
        <div>
          <p class="text-sm text-slate-500 font-medium">Total Riwayat</p>
          <p class="text-3xl font-bold text-slate-900"><%= kerjasamaList ? kerjasamaList.length : 0 %></p>
        </div>
      </div>

      <!-- Card 3: Bantuan -->
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 flex items-center gap-4">
        <div class="p-3 bg-amber-50 text-amber-600 rounded-xl">
          <i data-lucide="headphones" class="w-6 h-6"></i>
        </div>
        <div>
          <p class="text-sm text-slate-500 font-medium">Butuh Bantuan?</p>
          <a href="mailto:admin@kampus.ac.id" class="text-sm font-semibold text-indigo-600 hover:underline">Hubungi Admin Kampus &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Tabel Kerjasama -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
        <h3 class="font-bold text-slate-800 flex items-center gap-2">
          <i data-lucide="file-text" class="w-5 h-5 text-indigo-600"></i>
          Daftar Dokumen Kerjasama
        </h3>
      </div>
      
      <% if (kerjasamaList && kerjasamaList.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200 uppercase text-xs tracking-wider">
              <tr>
                <th class="px-6 py-4">Judul Kerjasama</th>
                <th class="px-6 py-4">Jenis</th>
                <th class="px-6 py-4">Masa Berlaku</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% kerjasamaList.forEach(function(k) { %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium text-slate-900"><%= k.judul %></td>
                  <td class="px-6 py-4">
                    <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-full text-xs font-semibold border border-indigo-100">
                      <%= k.jenis %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-slate-600 text-xs">
                    <div class="flex flex-col gap-1">
                      <span class="flex items-center gap-1"><i data-lucide="calendar" class="w-3 h-3"></i> Mulai: <%= new Date(k.tanggal_mulai).toLocaleDateString('id-ID') %></span>
                      <span class="flex items-center gap-1 text-slate-500"><i data-lucide="calendar-x" class="w-3 h-3"></i> Akhir: <%= new Date(k.tanggal_berakhir).toLocaleDateString('id-ID') %></span>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <% if (k.current_status === 'active') { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Aktif
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700 border border-red-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Expired
                      </span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <!-- Tombol Lihat Detail -->
                      <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-600 bg-slate-50 hover:bg-slate-100 rounded-lg transition-colors border border-slate-200">
                        <i data-lucide="eye" class="w-3.5 h-3.5"></i> Lihat
                      </button>
                      
                      <!-- Tombol Unggah Dokumen (BARU) -->
                      <button onclick="openUploadModal('<%= k.id %>')" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-colors border border-indigo-200">
                        <i data-lucide="upload-cloud" class="w-3.5 h-3.5"></i> Unggah
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <!-- Empty State yang Lebih Informatif -->
        <div class="p-16 text-center">
          <div class="bg-slate-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-200">
            <i data-lucide="inbox" class="w-10 h-10 text-slate-400"></i>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-1">Belum Ada Dokumen</h3>
          <p class="text-slate-500 max-w-md mx-auto mb-6">
            Saat ini belum ada dokumen kerjasama (MoU/MoA/IA) yang tercatat untuk perusahaan Anda di sistem kami.
          </p>
          <a href="mailto:admin@kampus.ac.id" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
            <i data-lucide="mail" class="w-4 h-4"></i> Hubungi Admin untuk Kerjasama
          </a>
        </div>
      <% } %>
    </div>

    <!-- ========================================== -->
    <!-- MODAL UNGGAH DOKUMEN MITRA                 -->
    <!-- ========================================== -->
    <div id="uploadModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4">
      <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden transform transition-all scale-100">
        
        <!-- Header Modal -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-slate-50/50">
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <i data-lucide="upload-cloud" class="w-5 h-5 text-indigo-600"></i>
            Unggah Dokumen
          </h3>
          <button onclick="closeUploadModal()" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-200 rounded-full transition-colors">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>

        <!-- Form Upload -->
        <!-- Catatan: enctype="multipart/form-data" WAJIB ada untuk upload file -->
        <form action="/portal-mitra/upload-dokumen" method="POST" enctype="multipart/form-data" class="p-6 space-y-4">
          
          <!-- Hidden Input untuk menyimpan ID Kerjasama -->
          <input type="hidden" name="kerjasama_id" id="upload_kerjasama_id">

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Pilih File Dokumen</label>
            <input type="file" name="dokumen" accept=".pdf,.jpg,.png" required 
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none text-sm 
                     file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold 
                     file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer">
            <p class="text-xs text-slate-500 mt-1.5 flex items-center gap-1">
              <i data-lucide="info" class="w-3 h-3"></i> Format yang didukung: .pdf, .jpg, .png (Maks. 5MB)
            </p>
          </div>

          <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
            <button type="button" onclick="closeUploadModal()" class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
              Batal
            </button>
            <button type="submit" class="px-5 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors shadow-sm flex items-center gap-2">
              <i data-lucide="upload" class="w-4 h-4"></i> Unggah Sekarang
            </button>
          </div>
        </form>
      </div>
    </div>

  </main>
  
  <script>
    // Inisialisasi icon Lucide
    lucide.createIcons();
    
    // Fungsi Buka Modal
    function openUploadModal(kerjasamaId) {
      // Masukkan ID kerjasama ke dalam hidden input di form
      document.getElementById('upload_kerjasama_id').value = kerjasamaId;
      
      // Tampilkan modal (hapus class hidden, tambah class flex)
      const modal = document.getElementById('uploadModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    // Fungsi Tutup Modal
    function closeUploadModal() {
      const modal = document.getElementById('uploadModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      
      // Opsional: Reset form agar bersih saat dibuka lagi
      const form = document.querySelector('form[action="/portal-mitra/upload-dokumen"]');
      if (form) form.reset();
    }

    // Tutup modal jika user klik di area gelap (backdrop)
    document.getElementById('uploadModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeUploadModal();
      }
    });
  </script>
</body>
</html>