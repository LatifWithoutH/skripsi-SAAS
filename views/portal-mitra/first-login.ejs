<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aktivasi Akun | Portal Mitra - SIMITRADUDIKA</title>
  
  <!-- 1. CSS Lokal (Hasil Compile) -->
  <link href="/css/output.css" rel="stylesheet">
  
  <!-- 2. Lucide Lokal -->
  <script src="/js/lucide.min.js"></script>
  
  <!-- 3. Custom Style untuk Animasi & Transisi -->
  <style>
    .transition-smooth { transition: all 0.2s ease-in-out; }
    
    @keyframes fadeInUp {
      0% { opacity: 0; transform: translateY(15px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
  </style>
</head>

<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 relative overflow-hidden font-sans text-slate-900 antialiased selection:bg-primary-100 selection:text-primary-700">
  
  <!-- Decorative Background Blob (Memberi kesan premium) -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary-500/5 rounded-full blur-3xl -z-10 pointer-events-none"></div>

  <div class="bg-white w-full max-w-md p-8 md:p-10 rounded-2xl shadow-xl border border-slate-200/60 animate-fade-in-up relative z-10">
    
    <!-- Header Section -->
    <div class="text-center mb-8">
      <div class="bg-primary-50 text-primary-600 w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-sm border border-primary-100">
        <i data-lucide="shield-check" class="w-8 h-8"></i>
      </div>
      <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Aktivasi Akun</h1>
      <p class="text-slate-600 mt-3 text-sm leading-relaxed">
        Halo, <span class="font-semibold text-primary-600"><%= typeof mitraName !== 'undefined' && mitraName ? mitraName : 'Mitra' %></span>! <br>
        Demi keamanan, silakan ganti password sementara Anda dengan password baru yang kuat.
      </p>
    </div>

    <!-- Error Handling (Lebih rapi dan deskriptif) -->
    <% if (typeof locals !== 'undefined' && locals.error) { %>
      <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3.5 rounded-xl flex items-start gap-3 text-sm animate-fade-in-up">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
        <div>
          <p class="font-semibold mb-0.5">Gagal Mengaktivasi</p>
          <% if (error === 'password_too_short') { %> 
            <p>Password minimal harus 8 karakter.</p>
          <% } else if (error === 'password_mismatch') { %> 
            <p>Konfirmasi password tidak cocok dengan password baru.</p>
          <% } else { %> 
            <p><%= error %></p>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Form Activation -->
    <form action="/portal-mitra/change-password" method="POST" class="space-y-5" id="activationForm" novalidate>
      
      <!-- New Password Input -->
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Password Baru</label>
        <div class="relative">
          <i data-lucide="lock" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
          <input type="password" name="new_password" id="new_password" required minlength="8"
            class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 outline-none transition-smooth text-sm placeholder:text-slate-400"
            placeholder="Minimal 8 karakter"
            autocomplete="new-password">
          <button type="button" onclick="togglePassword('new_password', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-smooth p-1" aria-label="Tampilkan password">
            <i data-lucide="eye" class="w-4 h-4 icon-eye-open"></i>
            <i data-lucide="eye-off" class="w-4 h-4 icon-eye-closed hidden"></i>
          </button>
        </div>
      </div>

      <!-- Confirm Password Input -->
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Konfirmasi Password</label>
        <div class="relative">
          <i data-lucide="lock-keyhole" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
          <input type="password" name="confirm_password" id="confirm_password" required minlength="8"
            class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 outline-none transition-smooth text-sm placeholder:text-slate-400"
            placeholder="Ulangi password baru"
            autocomplete="new-password">
          <button type="button" onclick="togglePassword('confirm_password', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-smooth p-1" aria-label="Tampilkan password">
            <i data-lucide="eye" class="w-4 h-4 icon-eye-open"></i>
            <i data-lucide="eye-off" class="w-4 h-4 icon-eye-closed hidden"></i>
          </button>
        </div>
        <!-- Real-time mismatch warning -->
        <p id="password-match-error" class="text-xs text-red-600 mt-2 hidden flex items-center gap-1.5 font-medium">
          <i data-lucide="x-circle" class="w-3.5 h-3.5"></i> Password tidak cocok!
        </p>
      </div>

      <!-- Submit Button -->
      <button type="submit" id="submitBtn" class="w-full bg-primary-600 text-white font-semibold py-3 rounded-xl hover:bg-primary-700 transition-all shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 text-sm mt-2 disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:translate-y-0">
        <span id="btnText">Aktivasi Akun</span>
        <i data-lucide="arrow-right" id="btnIcon" class="w-4 h-4"></i>
        <!-- Optional Spinner (jika ingin ditambahkan nanti) -->
        <!-- <svg id="btnSpinner" class="animate-spin h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">...</svg> -->
      </button>
    </form>

    <!-- Footer Info -->
    <div class="mt-8 pt-6 border-t border-slate-100 text-center">
      <p class="text-xs text-slate-500 flex items-center justify-center gap-1.5">
        <i data-lucide="info" class="w-3.5 h-3.5"></i>
        Setelah aktivasi, Anda akan otomatis diarahkan ke Dashboard Mitra.
      </p>
    </div>
  </div>

  <script>
    // Inisialisasi Icon
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    // 1. Fungsi Toggle Password Visibility
    function togglePassword(inputId, button) {
      const input = document.getElementById(inputId);
      const iconOpen = button.querySelector('.icon-eye-open');
      const iconClosed = button.querySelector('.icon-eye-closed');
      
      if (input.type === 'password') {
        input.type = 'text';
        iconOpen.classList.add('hidden');
        iconClosed.classList.remove('hidden');
      } else {
        input.type = 'password';
        iconOpen.classList.remove('hidden');
        iconClosed.classList.add('hidden');
      }
      // Re-render icons setelah perubahan DOM
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }

    // 2. Real-time Password Matching Validation (Mencegah submit sia-sia ke server)
    const newPass = document.getElementById('new_password');
    const confirmPass = document.getElementById('confirm_password');
    const matchError = document.getElementById('password-match-error');
    const form = document.getElementById('activationForm');

    function checkMatch() {
      if (confirmPass.value.length > 0) {
        if (newPass.value !== confirmPass.value) {
          matchError.classList.remove('hidden');
          confirmPass.classList.add('border-red-300', 'bg-red-50', 'focus:ring-red-500/20', 'focus:border-red-500');
          confirmPass.classList.remove('border-slate-300', 'bg-slate-50', 'focus:ring-primary-500/20', 'focus:border-primary-500');
        } else {
          matchError.classList.add('hidden');
          confirmPass.classList.remove('border-red-300', 'bg-red-50', 'focus:ring-red-500/20', 'focus:border-red-500');
          confirmPass.classList.add('border-slate-300', 'bg-slate-50', 'focus:ring-primary-500/20', 'focus:border-primary-500');
        }
      }
    }

    newPass.addEventListener('input', checkMatch);
    confirmPass.addEventListener('input', checkMatch);

    // 3. Intercept Submit jika masih tidak cocok
    form.addEventListener('submit', function(e) {
      if (newPass.value !== confirmPass.value || newPass.value.length < 8) {
        e.preventDefault();
        matchError.classList.remove('hidden');
        confirmPass.focus();
        
        // Opsional: Tambahkan alert atau shake animation di sini jika diinginkan
      }
    });
  </script>

  <!-- Global Script (jika ada fungsi reusable) -->
  <script src="/js/script.js"></script>
</body>
</html>