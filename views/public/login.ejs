<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cari Institusi | SIMITRADUDIKA</title>
  
  <!-- 1. CSS Lokal (Hasil Compile) -->
  <link href="/css/output.css" rel="stylesheet">
  
  <!-- 2. Lucide Lokal -->
  <script src="/js/lucide.min.js"></script>
  
  <!-- 3. Custom Style untuk Animasi & Glassmorphism -->
  <style>
    .glass-card {
      background: rgba(255, 255, 255, 0.90);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    @keyframes fadeInUp {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.6s ease-out forwards;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-primary-100 selection:text-primary-700 min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
  
  <!-- Decorative Background Blobs -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
    <div class="absolute -top-20 -left-20 w-96 h-96 bg-primary-500/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 -right-20 w-80 h-80 bg-purple-500/20 rounded-full blur-3xl"></div>
  </div>

  <!-- Main Content Container -->
  <div class="w-full max-w-md animate-fade-in-up" style="animation-delay: 0.1s;">
    
    <!-- Logo Header -->
    <div class="text-center mb-8">
      <a href="/" class="inline-flex items-center gap-2 text-slate-900 font-bold text-xl tracking-tight hover:opacity-80 transition-opacity">
        <div class="bg-primary-600 text-white p-2 rounded-lg shadow-lg shadow-primary-500/30">
          <i data-lucide="layers" class="w-5 h-5"></i>
        </div>
        SIMITRA<span class="text-primary-600">DUDIKA</span>
      </a>
    </div>

    <!-- Card Form -->
    <div class="glass-card w-full p-8 rounded-2xl shadow-2xl border border-slate-200/60">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-slate-900">Cari Institusi Anda</h2>
        <p class="text-slate-500 text-sm mt-2">Masukkan subdomain atau email institusi untuk diarahkan ke halaman login yang tepat.</p>
      </div>

      <!-- EJS Error / Info Message (Fallback jika JS dimatikan) -->
      <% if (locals.error) { %>
        <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-start gap-3 text-sm animate-fade-in-up">
          <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
          <div>
            <p class="font-semibold mb-1">Tidak Ditemukan</p>
            <p><%= error %></p>
          </div>
        </div>
      <% } else if (locals.success) { %>
        <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl flex items-start gap-3 text-sm animate-fade-in-up">
          <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
          <div>
            <p class="font-semibold mb-1">Informasi</p>
            <p><%= success %></p>
          </div>
        </div>
      <% } %>

      <!-- Form (Ditambahkan id="finderForm") -->
      <form action="/find-workspace" method="POST" class="space-y-5" id="finderForm">
        <div>
          <label for="identifier" class="block text-sm font-semibold text-slate-700 mb-1.5">Subdomain atau Email</label>
          <div class="relative">
            <i data-lucide="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
            <input 
              type="text" 
              name="identifier" 
              id="identifier"
              required 
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 outline-none transition-all text-sm placeholder:text-slate-400" 
              placeholder="Contoh: ums atau admin@ums.ac.id"
              autocomplete="off"
            >
          </div>
          <p class="text-xs text-slate-500 mt-2 flex items-center gap-1.5">
            <i data-lucide="info" class="w-3.5 h-3.5"></i>
            Kami akan mengarahkan Anda ke portal login institusi yang sesuai.
          </p>
        </div>

        <button 
          type="submit" 
          id="submitBtn" 
          class="w-full bg-primary-600 text-white font-semibold py-2.5 rounded-xl hover:bg-primary-700 transition-all shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:translate-y-0"
        >
          <span id="btnText">Lanjutkan ke Login</span>
          <i data-lucide="arrow-right" id="btnIcon" class="w-4 h-4"></i>
          <svg id="btnSpinner" class="animate-spin h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

      <!-- Footer Links inside Card -->
      <div class="mt-8 pt-6 border-t border-slate-100 text-center space-y-3">
        <p class="text-sm text-slate-600">
          Belum punya akun institusi? 
          <a href="/register" class="text-primary-600 font-semibold hover:text-primary-700 hover:underline transition-colors">Daftarkan Institusi</a>
        </p>
        <div class="flex items-center justify-center gap-2 text-xs text-slate-400">
          <span>atau</span>
          <a href="/portal-mitra/login" class="text-slate-500 hover:text-primary-600 underline decoration-slate-300 underline-offset-2 transition-colors">Login sebagai Mitra Industri</a>
        </div>
      </div>
    </div>
    
    <!-- Page Footer -->
    <p class="text-center text-xs text-slate-400 mt-8">&copy; 2026 SIMITRADUDIKA. Platform SaaS Multi-Tenant.</p>
  </div>

  <!-- ========================================== -->
  <!-- MODAL POPUP (Hidden by default)            -->
  <!-- ========================================== -->
  <div id="resultModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <!-- Backdrop Gelap -->
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeModal()"></div>
    
    <!-- Modal Card -->
    <div class="relative bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-sm p-6 transform transition-all scale-100 animate-fade-in-up">
      
      <!-- Tombol Tutup -->
      <button onclick="closeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>

      <!-- KONTEN SUKSES (Ditampilkan jika ditemukan) -->
      <div id="modalSuccess" class="hidden text-center">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
          <i data-lucide="check-circle-2" class="w-8 h-8"></i>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Institusi Ditemukan!</h3>
        <p class="text-slate-500 text-sm mb-6">
          Kami telah menemukan portal untuk <span id="modalInstitutionName" class="font-semibold text-primary-600">INSTITUSI</span>. 
          Silakan pilih cara untuk melanjutkan:
        </p>
        
        <div class="space-y-3">
          <button id="btnOpenSameTab" class="w-full bg-primary-600 text-white font-semibold py-2.5 rounded-xl hover:bg-primary-700 transition-all flex items-center justify-center gap-2">
            <i data-lucide="log-in" class="w-4 h-4"></i> Lanjutkan di Tab Ini
          </button>
          <button id="btnOpenNewTab" class="w-full bg-white text-slate-700 border border-slate-300 font-semibold py-2.5 rounded-xl hover:bg-slate-50 transition-all flex items-center justify-center gap-2">
            <i data-lucide="external-link" class="w-4 h-4"></i> Buka di Tab Baru
          </button>
        </div>
      </div>

      <!-- KONTEN ERROR (Ditampilkan jika tidak ditemukan) -->
      <div id="modalError" class="hidden text-center">
        <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
          <i data-lucide="search-x" class="w-8 h-8"></i>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Tidak Ditemukan</h3>
        <p id="modalErrorMessage" class="text-slate-500 text-sm mb-6">
          Subdomain atau email yang Anda masukkan tidak terdaftar dalam sistem kami.
        </p>
        <button onclick="closeModal()" class="w-full bg-slate-100 text-slate-700 font-semibold py-2.5 rounded-xl hover:bg-slate-200 transition-all">
          Coba Lagi
        </button>
      </div>

    </div>
  </div>

  <script src="/js/login-finder.js"></script>

  <!-- Global Script (jika ada fungsi reusable) -->
  <script src="/js/script.js"></script>
</body>