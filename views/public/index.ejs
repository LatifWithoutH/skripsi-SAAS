<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SaaS Multi-Tenant | Skripsi</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">
  <!-- Navbar -->
  <nav class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2 font-bold text-xl text-indigo-600">
        <i data-lucide="layers"></i> SaaS Skripsi
      </div>
      <div class="flex gap-4">
        <a href="/login" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-indigo-600 transition-colors">Masuk</a>
        <a href="/register" class="px-4 py-2 text-sm font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">Daftar</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <main class="max-w-7xl mx-auto px-6 py-20 text-center">
    <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 tracking-tight mb-6">
      Kelola Data Kampus dengan <span class="text-indigo-600">Aman & Terstruktur</span>
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-10">
      Platform SaaS multi-tenant yang dirancang untuk isolasi data, hierarki organisasi, dan keamanan tingkat enterprise. Cocok untuk kebutuhan institusi pendidikan.
    </p>
    <div class="flex justify-center gap-4">
      <a href="/register" class="px-8 py-3 text-base font-semibold bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200">
        Mulai Sekarang
      </a>
      <a href="#fitur" class="px-8 py-3 text-base font-semibold bg-white text-gray-700 border border-gray-300 rounded-xl hover:bg-gray-50 transition-all">
        Pelajari Fitur
      </a>
    </div>

    <!-- Mockup / Illustration Placeholder -->
    <div class="mt-16 bg-white rounded-2xl shadow-2xl border border-gray-200 p-2 max-w-4xl mx-auto">
      <div class="bg-gray-100 rounded-xl h-64 md:h-96 flex items-center justify-center text-gray-400">
        <div class="text-center">
          <i data-lucide="image" class="w-12 h-12 mx-auto mb-2"></i>
          <p>Area Screenshot Dashboard Aplikasi</p>
        </div>
      </div>
    </div>
  </main>

  <script>lucide.createIcons();</script>
</body>
</html>