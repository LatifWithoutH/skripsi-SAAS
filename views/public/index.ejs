<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIMITRADUDIKA | Platform SaaS Multi-Tenant</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          },
          animation: {
            'float': 'float 6s ease-in-out infinite',
            'fade-in-up': 'fadeInUp 0.8s ease-out forwards',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-10px)' },
            },
            fadeInUp: {
              '0%': { opacity: '0', transform: 'translateY(20px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            }
          }
        }
      }
    }
  </script>
  <style>
    .glass-nav {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .gradient-text {
      background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-primary-100 selection:text-primary-700">
  
  <!-- Navbar (Sticky & Glassmorphism) -->
  <nav class="fixed top-0 w-full z-50 glass-nav border-b border-slate-200/60 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2.5">
        <div class="bg-primary-600 text-white p-2 rounded-lg shadow-lg shadow-primary-500/30">
          <i data-lucide="layers" class="w-5 h-5"></i>
        </div>
        <span class="font-bold text-xl text-slate-900 tracking-tight">SIMITRA<span class="text-primary-600">DUDIKA</span></span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/login" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-primary-600 transition-colors">Masuk</a>
        <a href="/register" class="px-5 py-2.5 text-sm font-semibold bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-all shadow-md shadow-primary-500/20 hover:shadow-primary-500/40 hover:-translate-y-0.5">
          Daftar Institusi
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <main class="pt-32 pb-20 px-6">
    <div class="max-w-7xl mx-auto text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-50 border border-primary-100 text-primary-700 text-sm font-medium mb-8 animate-fade-in-up">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-600"></span>
        </span>
        Solusi SaaS Multi-Tenant untuk Pendidikan
      </div>

      <!-- Headline -->
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-slate-900 tracking-tight mb-6 animate-fade-in-up" style="animation-delay: 0.1s;">
        Kelola Data Kampus dengan <br class="hidden md:block" />
        <span class="gradient-text">Aman, Terstruktur & Modern</span>
      </h1>
      
      <!-- Subheadline -->
      <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in-up" style="animation-delay: 0.2s;">
        Platform terpusat untuk mengelola kerjasama antara Universitas dan Dunia Industri (DUDIKA) dengan isolasi data tingkat enterprise, RBAC, dan audit log forensik.
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-20 animate-fade-in-up" style="animation-delay: 0.3s;">
        <a href="/register" class="px-8 py-4 text-base font-semibold bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-all shadow-xl shadow-primary-500/25 hover:shadow-primary-500/40 hover:-translate-y-1 flex items-center justify-center gap-2">
          Mulai Uji Coba Gratis <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
        <a href="#fitur" class="px-8 py-4 text-base font-semibold bg-white text-slate-700 border border-slate-200 rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center justify-center gap-2">
          <i data-lucide="play-circle" class="w-4 h-4"></i> Pelajari Fitur
        </a>
      </div>

      <!-- Mockup / Illustration Placeholder -->
      <div class="relative max-w-5xl mx-auto animate-fade-in-up" style="animation-delay: 0.4s;">
        <!-- Decorative blur blobs -->
        <div class="absolute -top-10 -left-10 w-72 h-72 bg-primary-500/20 rounded-full blur-3xl -z-10"></div>
        <div class="absolute -bottom-10 -right-10 w-72 h-72 bg-purple-500/20 rounded-full blur-3xl -z-10"></div>
        
        <!-- Mockup Container -->
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200/60 p-2 md:p-3 animate-float">
          <div class="bg-slate-50 rounded-xl h-64 md:h-[500px] flex items-center justify-center border border-slate-100 relative overflow-hidden group">
            <!-- Subtle Grid Pattern Background -->
            <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#4f46e5 1px, transparent 1px); background-size: 24px 24px;"></div>
            
            <div class="text-center z-10 p-8">
              <div class="w-20 h-20 bg-primary-100 text-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
                <i data-lucide="layout-dashboard" class="w-10 h-10"></i>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Dashboard SIMITRADUDIKA</h3>
              <p class="text-slate-500 max-w-md mx-auto">Area ini akan menampilkan screenshot dashboard aplikasi yang responsif, modern, dan penuh dengan data analitik real-time.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Features Section (Agar tombol "Pelajari Fitur" berfungsi) -->
  <section id="fitur" class="py-24 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">Mengapa Memilih SIMITRADUDIKA?</h2>
        <p class="text-lg text-slate-600">Dibangun dengan standar keamanan industri untuk memenuhi kebutuhan digitalisasi institusi pendidikan modern.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:border-primary-200 hover:shadow-xl hover:shadow-primary-500/5 transition-all duration-300 group">
          <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <i data-lucide="shield-check" class="w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Keamanan Multi-Tenant</h3>
          <p class="text-slate-600 leading-relaxed">Isolasi data ketat berbasis <code class="bg-slate-200 px-1.5 py-0.5 rounded text-sm text-slate-800">tenant_id</code>. Data satu kampus tidak akan pernah bocor ke kampus lain.</p>
        </div>

        <!-- Feature 2 -->
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:border-primary-200 hover:shadow-xl hover:shadow-primary-500/5 transition-all duration-300 group">
          <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <i data-lucide="file-check" class="w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Audit Log Forensik</h3>
          <p class="text-slate-600 leading-relaxed">Setiap aksi tercatat dengan detail: IP Address, User Agent, dan Timestamp. Mendukung pelacakan aktivitas mencurigakan secara real-time.</p>
        </div>

        <!-- Feature 3 -->
        <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:border-primary-200 hover:shadow-xl hover:shadow-primary-500/5 transition-all duration-300 group">
          <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <i data-lucide="users" class="w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">RBAC & Hierarki Fleksibel</h3>
          <p class="text-slate-600 leading-relaxed">Atur hak akses granular untuk Tenant Owner, IT Admin, Faculty Operator, hingga Auditor dengan mudah dan terstruktur.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-2">
        <i data-lucide="layers" class="w-5 h-5 text-primary-500"></i>
        <span class="font-bold text-slate-200">SIMITRADUDIKA</span>
      </div>
      <p class="text-sm">© 2026 SIMITRADUDIKA. Proyek Skripsi S1 Sistem Informasi.</p>
    </div>
  </footer>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>