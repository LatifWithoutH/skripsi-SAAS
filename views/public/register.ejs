<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Tenant | SaaS Skripsi</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-100 h-screen overflow-hidden flex items-center justify-center p-4">

  <div class="bg-white w-full max-w-6xl rounded-2xl shadow-2xl border border-gray-200 flex overflow-hidden" style="max-height: 95vh;">

    <!-- LEFT PANEL: Pricing (Tetap sama) -->
    <div class="w-2/5 bg-gradient-to-br from-indigo-600 to-purple-700 p-6 flex flex-col justify-between text-white">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="bg-white/20 backdrop-blur w-10 h-10 rounded-xl flex items-center justify-center">
            <i data-lucide="building-2" class="w-5 h-5"></i>
          </div>
          <div>
            <h1 class="text-lg font-bold">SaaS Skripsi</h1>
            <p class="text-xs text-indigo-200">Daftar Institusi Baru</p>
          </div>
        </div>

        <h2 class="text-xl font-bold mb-1">Pilih Paket</h2>
        <p class="text-xs text-indigo-200 mb-5">Sesuaikan dengan kebutuhan kampus</p>

        <div class="space-y-3">
          <label class="cursor-pointer block">
            <input type="radio" name="subscription_plan" value="starter" class="sr-only peer" checked>
            <div class="peer-checked:bg-white/20 peer-checked:border-white border border-white/30 rounded-xl p-3 transition-all hover:bg-white/10">
              <div class="flex justify-between items-center mb-1">
                <span class="font-bold text-sm">Starter</span>
                <span class="text-sm font-bold">Rp 49rb<span class="text-xs font-normal text-indigo-200">/bln</span></span>
              </div>
              <div class="text-xs text-indigo-200 space-y-0.5">
                <p>✓ 5 User · 20 Data Mitra</p>
                <p>✓ SSL Terenkripsi</p>
              </div>
            </div>
          </label>

          <label class="cursor-pointer block">
            <input type="radio" name="subscription_plan" value="premium" class="sr-only peer">
            <div class="peer-checked:bg-white/20 peer-checked:border-white border border-white/30 rounded-xl p-3 transition-all hover:bg-white/10">
              <div class="flex justify-between items-center mb-1">
                <span class="font-bold text-sm">Premium</span>
                <span class="text-sm font-bold">Rp 149rb<span class="text-xs font-normal text-indigo-200">/bln</span></span>
              </div>
              <div class="text-xs text-indigo-200 space-y-0.5">
                <p>✓ 25 User · Mitra Unlimited</p>
                <p>✓ Portal Mitra · Export PDF</p>
              </div>
            </div>
          </label>

          <label class="cursor-pointer block">
            <input type="radio" name="subscription_plan" value="enterprise" class="sr-only peer">
            <div class="peer-checked:bg-white/20 peer-checked:border-white border border-white/30 rounded-xl p-3 transition-all hover:bg-white/10">
              <div class="flex justify-between items-center mb-1">
                <span class="font-bold text-sm">Enterprise</span>
                <span class="text-sm font-bold">Custom</span>
              </div>
              <div class="text-xs text-indigo-200 space-y-0.5">
                <p>✓ Unlimited · Dedicated Server</p>
                <p>✓ SLA 99.9% · Support 24/7</p>
              </div>
            </div>
          </label>
        </div>
      </div>

      <div class="bg-white/10 backdrop-blur rounded-xl p-3 mt-4">
        <div class="flex gap-2 items-start">
          <i data-lucide="info" class="w-4 h-4 flex-shrink-0 mt-0.5"></i>
          <p class="text-xs text-indigo-100">Simulasi skripsi: aktivasi langsung tanpa payment gateway.</p>
        </div>
      </div>
    </div>

    <!-- RIGHT PANEL: Form -->
    <div class="w-3/5 p-6 flex flex-col overflow-y-auto">
      <div class="mb-4">
        <h2 class="text-xl font-bold text-gray-900">Data Institusi & Admin</h2>
        <p class="text-xs text-gray-500">Lengkapi form di bawah untuk mendaftar</p>
      </div>

      <!-- ERROR MESSAGE CONTAINER (Untuk error dari backend) -->
      <% if (locals.error) { %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
        <% if (error === 'password_mismatch') { %> Password dan konfirmasi password tidak cocok!
        <% } else if (error === 'terms_required') { %> Anda harus menyetujui Syarat & Ketentuan!
        <% } else if (error === 'email_exists') { %> Email ini sudah terdaftar di sistem!
        <% } else { %> Terjadi kesalahan pada server. Silakan coba lagi.
        <% } %>
      </div>
      <% } %>

      <form action="/register" method="POST" class="space-y-4 flex-1 flex flex-col" id="registerForm" novalidate>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Nama Institusi <span class="text-red-500">*</span></label>
          <input type="text" name="tenant_name" required class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" placeholder="Universitas Nusantara">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Email Pengelola <span class="text-red-500">*</span></label>
          <input type="email" name="email" required class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" placeholder="admin@kampus.ac.id">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">Password <span class="text-red-500">*</span></label>
            <input type="password" name="password" id="password" required minlength="12" class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" placeholder="Min. 12 karakter">
            
            <!-- REAL-TIME PASSWORD REQUIREMENTS CHECKLIST -->
            <div class="mt-2 space-y-1 text-xs" id="password-requirements">
              <div class="flex items-center gap-2 text-gray-500" id="req-length">
                <i data-lucide="circle" class="w-3 h-3"></i> Minimal 12 karakter
              </div>
              <div class="flex items-center gap-2 text-gray-500" id="req-upper">
                <i data-lucide="circle" class="w-3 h-3"></i> Minimal 1 huruf besar (A-Z)
              </div>
              <div class="flex items-center gap-2 text-gray-500" id="req-number">
                <i data-lucide="circle" class="w-3 h-3"></i> Minimal 1 angka (0-9)
              </div>
              <div class="flex items-center gap-2 text-gray-500" id="req-symbol">
                <i data-lucide="circle" class="w-3 h-3"></i> Minimal 1 simbol (@$!%*?&)
              </div>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">Konfirmasi Password <span class="text-red-500">*</span></label>
            <input type="password" name="confirm_password" id="confirm_password" required minlength="12" class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" placeholder="Ulangi password">
            <p id="password-match-error" class="text-[10px] text-red-600 mt-1 hidden flex items-center gap-1">
              <i data-lucide="x-circle" class="w-3 h-3"></i> Password tidak cocok!
            </p>
          </div>
        </div>

        <div class="flex items-start gap-2">
          <input type="checkbox" name="agree_terms" id="agree_terms" required class="mt-0.5 w-3.5 h-3.5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
          <label for="agree_terms" class="text-xs text-gray-600">
            Saya setuju dengan <a href="#" class="text-indigo-600 hover:underline font-semibold">Syarat & Ketentuan</a> dan <a href="#" class="text-indigo-600 hover:underline font-semibold">Kebijakan Privasi</a>.
          </label>
        </div>

        <div class="mt-auto pt-2">
          <button type="submit" id="submitBtn" class="w-full bg-indigo-600 text-white font-semibold py-2.5 rounded-lg hover:bg-indigo-700 transition-colors shadow-md flex items-center justify-center gap-2 text-sm disabled:opacity-50 disabled:cursor-not-allowed">
            <span id="btnText">Buat Tenant & Mulai Langganan</span>
            <svg id="btnSpinner" class="animate-spin h-4 w-4 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </div>

      </form>
    </div>

  </div>

  <script>
    lucide.createIcons();

    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirm_password');
    const matchError = document.getElementById('password-match-error');
    const form = document.getElementById('registerForm');

    // Regex untuk validasi
    const hasUpper = /[A-Z]/;
    const hasNumber = /\d/;
    const hasSymbol = /[@$!%*?&]/;

    // Fungsi update checklist real-time
    function updatePasswordRequirements() {
      const val = passwordInput.value;
      
      updateRequirement('req-length', val.length >= 12);
      updateRequirement('req-upper', hasUpper.test(val));
      updateRequirement('req-number', hasNumber.test(val));
      updateRequirement('req-symbol', hasSymbol.test(val));
      
      // Cek juga match saat password utama berubah
      checkPasswordMatch();
    }

    function updateRequirement(id, isValid) {
      const el = document.getElementById(id);
      const icon = el.querySelector('i');
      
      if (isValid) {
        el.classList.remove('text-gray-500');
        el.classList.add('text-emerald-600');
        icon.setAttribute('data-lucide', 'check-circle');
      } else {
        el.classList.add('text-gray-500');
        el.classList.remove('text-emerald-600');
        icon.setAttribute('data-lucide', 'circle');
      }
      lucide.createIcons(); // Refresh icon
    }

    function checkPasswordMatch() {
      if (confirmInput.value.length > 0) {
        if (passwordInput.value !== confirmInput.value) {
          matchError.classList.remove('hidden');
          confirmInput.classList.add('border-red-500', 'focus:ring-red-500');
          confirmInput.classList.remove('border-gray-300', 'focus:ring-indigo-500');
        } else {
          matchError.classList.add('hidden');
          confirmInput.classList.remove('border-red-500', 'focus:ring-red-500');
          confirmInput.classList.add('border-gray-300', 'focus:ring-indigo-500');
        }
      }
    }

    // Event Listeners
    passwordInput.addEventListener('input', updatePasswordRequirements);
    confirmInput.addEventListener('input', checkPasswordMatch);

    // Handle Submit
    form.addEventListener('submit', function(e) {
      const val = passwordInput.value;
      const isLengthValid = val.length >= 12;
      const isUpperValid = hasUpper.test(val);
      const isNumberValid = hasNumber.test(val);
      const isSymbolValid = hasSymbol.test(val);
      const isMatch = val === confirmInput.value;
      const isTermsChecked = document.getElementById('agree_terms').checked;

      if (!isLengthValid || !isUpperValid || !isNumberValid || !isSymbolValid) {
        e.preventDefault();
        alert('Mohon lengkapi semua syarat password yang ditandai di atas.');
        return;
      }

      if (!isMatch) {
        e.preventDefault();
        matchError.classList.remove('hidden');
        confirmInput.classList.add('border-red-500');
        return;
      }

      if (!isTermsChecked) {
        e.preventDefault();
        alert('Anda harus menyetujui Syarat & Ketentuan terlebih dahulu!');
        return;
      }

      // Jika semua valid, tampilkan loading
      const submitBtn = document.getElementById('submitBtn');
      const btnText = document.getElementById('btnText');
      const btnSpinner = document.getElementById('btnSpinner');
      
      submitBtn.disabled = true;
      btnText.textContent = 'Memproses...';
      btnSpinner.classList.remove('hidden');
    });
  </script>
</body>
</html>